<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data>
  
    <record id="sequence_view_alnas_roman_sequence" model="ir.ui.view">
      <field name="name">ir.sequence.form.alnas_roman_sequence</field>
      <field name="model">ir.sequence</field>
      <field name="inherit_id" ref="base.sequence_view"/>
      <field name="arch" type="xml">
        <data>
          <field name="padding" position="after">
            <field name="is_roman" widget="boolean_toggle"/>
          </field>
          <xpath expr="//page[@name='sequence']/group[2]/group[2]" position="inside">
            <span colspan="2">Roman Numbering: %%(roman_*key*)s</span>
          </xpath>
        </data>
      </field>
    </record>
  
  </data>
  

</odoo>
